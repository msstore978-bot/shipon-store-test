var Expenses = {headers:function(){return ['Expense_ID','Date','Category','Description','Amount','Payment_Method','Note','CreatedAt','UpdatedAt','User_ID','Version'];},sheet:function(){return SheetStore.ensureSheet_('Expenses',this.headers());},list:function(user,payload){requireRole_(user,['ADMIN']);var a=SheetStore.records_(this.sheet());return ok_(a);},create:function(user,payload){requireRole_(user,['ADMIN']);var id=clean_(payload&&payload.id)||Utilities.getUuid(),sh=this.sheet();if(SheetStore.findBy_(sh,'Expense_ID',id))return ok_({expenseId:id,duplicate:true});var now=new Date().toISOString(),amt=Math.max(0,Number(payload.amount||0));SheetStore.append_(sh,{Expense_ID:id,Date:payload.date||now.slice(0,10),Category:clean_(payload.category)||'General',Description:clean_(payload.description),Amount:amt,Payment_Method:clean_(payload.paymentMethod)||'Cash',Note:clean_(payload.note),CreatedAt:now,UpdatedAt:now,User_ID:user.userId||'',Version:1});Audit.write_(user,'EXPENSE_CREATE','Expenses',id,payload);return ok_({expenseId:id,amount:amt});}};
