var Profit = {summary:function(user,payload){requireRole_(user,['ADMIN']);var sales=readIfExists_('Sales'),items=readIfExists_('Sale_Items'),expenses=readIfExists_('Expenses');var itemMap={};items.forEach(function(i){var sid=String(i.Sale_ID);(itemMap[sid]||(itemMap[sid]=[])).push(i);});function calc(s){var gross=Number(s.Total_Bill||0);var arr=itemMap[String(s.Sale_ID)]||[];if(arr.length)gross=arr.reduce(function(a,i){return a+Number(i.Quantity||0)*(Number(i.Unit_Price||0)-Number(i.Unit_Cost||0));},0);return gross-Number(s.Discount||0)-Number(s.Commission||0);}var now=new Date(),tz=getConfig_().timezone;function key(d){return Utilities.formatDate(new Date(d),tz,'yyyy-MM-dd');}var today=key(now),month=today.slice(0,7),year=today.slice(0,4);function range(kind){var gs=0,ex=0,rev=0; sales.forEach(function(s){var k=key(s.Date||s.CreatedAt),m=kind==='day'?k===today:kind==='month'?k.slice(0,7)===month:k.slice(0,4)===year;if(m){rev+=Number(s.Total_Bill||0);gs+=calc(s);}});expenses.forEach(function(e){var k=key(e.Date||e.CreatedAt),m=kind==='day'?k===today:kind==='month'?k.slice(0,7)===month:k.slice(0,4)===year;if(m)ex+=Number(e.Amount||0);});return {revenue:rev,grossProfit:gs,expense:ex,netProfit:gs-ex};}return ok_({today:range('day'),month:range('month'),year:range('year')});}};
