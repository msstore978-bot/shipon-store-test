{
  "name": "shipon-store-offline",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
