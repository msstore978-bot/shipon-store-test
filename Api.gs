function parseRequestBody_(e){if(!e||!e.postData||!e.postData.contents)return {action:(e&&e.parameter&&e.parameter.action)||'health',payload:(e&&e.parameter)||{}};try{return JSON.parse(e.postData.contents);}catch(_){return {action:'invalid',payload:{}};}}
function routeApi_(req){req=req||{};var action=String(req.action||'').trim(),payload=req.payload||{},auth=req.auth||{};if(action==='health')return apiResponse_({success:true,data:{status:'ok',version:API_VERSION}});if(action==='login')return Auth.login(payload);var session=Auth.requireSession(auth),user=session.user;switch(action){case 'bootstrap':return bootstrap_(user);case 'dashboard':return Dashboard.get(user,payload);case 'profit.summary':return Profit.summary(user,payload);case 'products.list':return Products.list(user,payload);case 'products.get':return Products.get(user,payload);case 'products.create':return Products.create(user,payload);case 'products.update':return Products.update(user,payload);case 'inventory.list':return Inventory.list(user,payload);case 'inventory.adjust':return Inventory.adjust(user,payload);case 'stock_ledger.list':return StockLedger.list(user,payload);case 'purchases.create':return Purchases.create(user,payload);case 'suppliers.list':return Suppliers.list(user,payload);case 'suppliers.create':return Suppliers.create(user,payload);case 'suppliers.payment':return Suppliers.payment(user,payload);case 'suppliers.transactions':return Suppliers.transactions(user,payload);case 'expenses.list':return Expenses.list(user,payload);case 'expenses.create':return Expenses.create(user,payload);case 'sales.create':return Sales.create(user,payload);case 'customers.list':return Customers.list(user,payload);case 'customers.get':return Customers.get(user,payload);case 'customers.create':return Customers.create(user,payload);case 'customers.update':return Customers.update(user,payload);case 'customers.delete':return Customers.remove(user,payload);case 'transactions.list':return Customers.transactions(user,payload);case 'payments.create':return Payments.create(user,payload);case 'due.create':return Due.create(user,payload);case 'reminders.get':return Reminders.get(user,payload);case 'reminders.save':return Reminders.save(user,payload);case 'reminders.disable':return Reminders.disable(user,payload);case 'sync.push':return Sync.push(user,payload);case 'sync.pull':return Sync.pull(user,payload);case 'image.upload':return Images.upload(user,payload);case 'audit.list':return Audit.list(user,payload);default:return apiResponse_({success:false,data:null,message:'Unknown action',error:{code:'UNKNOWN_ACTION',details:action}});}}
function apiResponse_(obj){var out=obj||{};out.serverTime=new Date().toISOString();out.apiVersion=API_VERSION;return ContentService.createTextOutput(JSON.stringify(out)).setMimeType(ContentService.MimeType.JSON);}
function ok_(data,message){return apiResponse_({success:true,data:data,message:message||''});}
function fail_(code,message,details){return apiResponse_({success:false,data:null,message:message||'Request failed',error:{code:code,details:details||''}});}
