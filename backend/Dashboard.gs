var Dashboard={get:function(user,payload){requireRole_(user,['ADMIN','STAFF']);var customers=readIfExists_('Customers'),sales=readIfExists_('Sales'),expenses=readIfExists_('Expenses'),products=readIfExists_('Products'),now=new Date(),tz=getConfig_().timezone,today=Utilities.formatDate(now,tz,'yyyy-MM-dd'),month=today.slice(0,7),year=today.slice(0,4),ts=0,ms=0,ys=0,te=0,me=0,ye=0; sales.forEach(function(r){var d=Utilities.formatDate(new Date(r.Date||r.CreatedAt),tz,'yyyy-MM-dd'),v=Number(r.Total_Bill||0);if(d===today)ts+=v;if(d.slice(0,7)===month)ms+=v;if(d.slice(0,4)===year)ys+=v;});expenses.forEach(function(r){var d=Utilities.formatDate(new Date(r.Date||r.CreatedAt),tz,'yyyy-MM-dd'),v=Number(r.Amount||0);if(d===today)te+=v;if(d.slice(0,7)===month)me+=v;if(d.slice(0,4)===year)ye+=v;});var due=customers.reduce(function(a,r){return a+Number(r.Current_Due||0);},0),low=products.filter(function(r){return Number(r.Current_Stock||0)<=Number(r.Low_Stock_Level||0);}).length;return ok_({totalCustomers:customers.length,totalDue:due,todaySales:ts,monthlySales:ms,yearlySales:ys,todayExpense:te,monthlyExpense:me,yearlyExpense:ye,lowStockProducts:low,serverDate:now.toISOString(),greeting:getGreeting_()});}};
function readIfExists_(name){var sh=getDb_().getSheetByName(name);return sh?SheetStore.records_(sh):[];}
function getGreeting_(){var h=Number(Utilities.formatDate(new Date(),getConfig_().timezone,'H'));if(h>=5&&h<11)return 'শুভ সকাল';if(h>=11&&h<14)return 'শুভ মধ্যাহ্ন';if(h>=14&&h<17)return 'শুভ অপরাহ্ন';if(h>=17&&h<20)return 'শুভ সন্ধ্যা';if(h>=20||h<5)return 'শুভ রাত্রি';return 'স্বাগতম';}
function bootstrap_(user){return ok_({user:user,dashboard:JSON.parse(unwrap_(Dashboard.get(user,{}))),customers:JSON.parse(unwrap_(Customers.list(user,{query:''}))),serverTime:new Date().toISOString()});}
function unwrap_(response){return response.getContent();}
